{
  "name": "@trust-lab/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "i18n:gen": "node scripts/gen-sr-latn.mjs",
    "i18n:check": "node scripts/gen-sr-latn.mjs --check",
    "predev": "npm run i18n:gen",
    "dev": "vite",
    "prebuild": "npm run i18n:gen",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots"
  },
  "dependencies": {
    "@trust-lab/game-core": "*",
    "vue": "^3.5.0",
    "vue-i18n": "^11.1.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@intlify/unplugin-vue-i18n": "^11.0.0",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0",
    "vue-tsc": "^3.0.0"
  }
}
